rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberUids;
    }

    function isActiveMember(coupleId) {
      return isCoupleMember(coupleId)
        && get(/databases/$(database)/documents/couples/$(coupleId)).data.status == 'active';
    }

    function isMatchMember(matchId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/singleMatches/$(matchId))
        && request.auth.uid in get(/databases/$(database)/documents/singleMatches/$(matchId)).data.memberUids;
    }

    function canReadPost(post) {
      return isActiveMember(post.ownerCoupleId)
        || (
          post.keys().hasAll(['ownerUid'])
          && post.ownerUid == request.auth.uid
          && post.ownerCoupleId == request.auth.uid
        )
        || post.visibility == 'public'
        || (
          post.visibility == 'followers'
          && post.keys().hasAll(['ownerUid'])
          && exists(/databases/$(database)/documents/personFollows/$(request.auth.uid + '_' + post.ownerUid))
        )
        || (post.keys().hasAll(['pendingCollaboratorUids']) && request.auth.uid in post.pendingCollaboratorUids)
        || (post.keys().hasAll(['acceptedCollaboratorUids']) && request.auth.uid in post.acceptedCollaboratorUids);
    }

    function hasValidDateRating(rating) {
      return rating is map
        && rating.keys().hasOnly(['stars', 'comment', 'tags', 'ratedByUid', 'ratedAt'])
        && rating.stars is int
        && rating.stars >= 1
        && rating.stars <= 5
        && (rating.comment == null || (rating.comment is string && rating.comment.size() <= 280))
        && rating.tags is list
        && rating.tags.size() <= 5
        && rating.ratedAt is timestamp
        && rating.ratedByUid == request.auth.uid;
    }

    function canCreateSavedDate() {
      let plan = request.resource.data;
      return plan.keys().hasOnly(['sourceRequestId', 'sourceSuggestionId', 'title', 'scheduledAt',
          'createdByUid', 'createdAt', 'status', 'stations', 'rating'])
        && plan.sourceRequestId is string && plan.sourceRequestId.size() > 0 && plan.sourceRequestId.size() <= 200
        && plan.sourceSuggestionId is string && plan.sourceSuggestionId.size() > 0 && plan.sourceSuggestionId.size() <= 200
        && plan.title is string && plan.title.size() > 0 && plan.title.size() <= 240
        && plan.createdAt is timestamp
        && plan.stations is list && plan.stations.size() > 0 && plan.stations.size() <= 8
        && plan.createdByUid == request.auth.uid
        && plan.status == 'upcoming' && plan.rating == null
        && plan.scheduledAt is timestamp && plan.scheduledAt > request.time;
    }

    function canUpdateSavedDate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'upcoming' && resource.data.rating == null && (
        (changed.hasOnly(['status']) && request.resource.data.status == 'cancelled')
        || (changed.hasOnly(['status', 'rating'])
          && request.resource.data.status == 'completed'
          && request.time >= resource.data.scheduledAt
          && hasValidDateRating(request.resource.data.rating))
        || (changed.hasOnly(['scheduledAt'])
          && request.resource.data.scheduledAt is timestamp
          && request.resource.data.scheduledAt > request.time)
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'authProvider', 'dietaryDefault', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.authProvider in ['apple', 'password']
        && request.resource.data.dietaryDefault is list
        && request.resource.data.dietaryDefault.size() == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          !('email' in request.resource.data)
          || (
            request.resource.data.email is string
            && request.resource.data.email.size() <= 254
            && request.auth.token.email == request.resource.data.email
          )
        );
      // Client-side selection only chooses the immediate experience. Couple assignment and the
      // matching deactivation after a connection remain server-only callable mutations.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountMode', 'datingEnabled'])
        && (!('accountMode' in resource.data) || resource.data.accountMode == null)
        && request.resource.data.accountMode in ['couple', 'single']
        && request.resource.data.datingEnabled == (request.resource.data.accountMode == 'single');
      allow delete: if false;

      // Personal plans are private to their owner, just as pair and match plans are private
      // to their members. Subcollections do not inherit the parent document's read rule.
      match /dateRequests/{requestId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /savedDates/{savedDateId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid && canCreateSavedDate();
        allow update: if isSignedIn() && request.auth.uid == uid && canUpdateSavedDate();
        allow delete: if false;
      }

      // A device can register only its own opaque FCM token. Clients cannot enumerate tokens;
      // Cloud Functions use them exclusively to deliver generic, opt-in notifications.
      match /deviceTokens/{token} {
        allow read: if false;
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token == token
          && request.resource.data.platform == 'ios';
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Matching candidates are supplied through callable Functions after block/preference checks.
    // A single user can only observe their own full profile document directly.
    match /singleProfiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /singleMatches/{matchId} {
      allow read: if isMatchMember(matchId);
      allow write: if false;

      // Both people in a confirmed match may plan and rate a shared date. Client writes are
      // constrained to the same minimal shape as couple dates; match lifecycle stays server-only.
      match /dateRequests/{requestId} {
        allow read: if isMatchMember(matchId);
        allow write: if false;
      }

      match /savedDates/{savedDateId} {
        allow read: if isMatchMember(matchId);

        allow create: if isMatchMember(matchId)
          && canCreateSavedDate();

        allow update: if isMatchMember(matchId)
          && canUpdateSavedDate();

        // Dates are part of the shared history. Cancelling retains the record for both people;
        // deletion would otherwise let one match member silently erase that shared context.
        allow delete: if false;
      }

      // Message creation is callable-function-only, which ensures sender identity and the
      // first-contact guardrails are checked on the server. Both confirmed members may read.
      match /messages/{messageId} {
        allow read: if isMatchMember(matchId);
        allow write: if false;
      }

    }

    match /singleInterests/{interestId} {
      allow read, write: if false;
    }

    match /singleBlocks/{blockId} {
      allow read, write: if false;
    }

    match /singleReports/{reportId} {
      allow read, write: if false;
    }

    // Stripe session metadata and outcomes are server-maintained. The UI reads the small
    // verification status projection from its own users/{uid} document instead.
    match /singleVerifications/{uid} {
      allow read, write: if false;
    }

    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Contains only intentionally public profile fields. Lifecycle and updates are callable-
    // function only, preventing client code from smuggling private account data into it.
    match /coupleProfiles/{coupleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Public social identities are opt-in. The private users/{uid} document remains visible only
    // to its owner; connecting to a couple never publishes someone without this explicit flag.
    match /personProfiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || resource.data.isDiscoverable == true);
      allow write: if false;
    }

    match /personProfileHandles/{handle} {
      allow read, write: if false;
    }

    // Used only as an internal unique-handle reservation ledger.
    match /profileHandles/{handle} {
      allow read, write: if false;
    }

    match /follows/{followId} {
      allow read, write: if false;
    }

    // Personal connections are server-maintained. The app receives only the caller's own
    // relationship state through a callable, never a browseable follower graph.
    match /personFollows/{followId} {
      allow read, write: if false;
    }

    match /socialBlocks/{blockId} {
      allow read, write: if false;
    }

    match /socialReports/{reportId} {
      allow read, write: if false;
    }

    // Invited people may see a group plan before responding; only Functions create, update or
    // cancel it so an invite cannot be forged or another attendee's response overwritten.
    match /groupEvents/{eventId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow write: if false;

      // Chat content stays inside the invited planning circle. All writes run through callable
      // functions so participant identity and proposal permissions are always server-checked.
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groupEvents/$(eventId)).data.participantUids;
        allow write: if false;
      }

      // Availability contains only answers for event-specific candidate slots; calendar event
      // titles and metadata never leave the participant's device. Mutations remain callable-only.
      match /availability/{uid} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groupEvents/$(eventId)).data.participantUids;
        allow write: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groupEvents/$(eventId)).data.participantUids;
        allow write: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groupEvents/$(eventId)).data.participantUids;
        allow write: if false;
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn() && canReadPost(resource.data);
      allow write: if false;

      match /likes/{coupleId} {
        allow read: if isSignedIn() && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow write: if false;
      }

      match /saves/{coupleId} {
        allow read: if isSignedIn() && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow write: if false;
      }

      // Creation and moderation are callable-only. Reads keep the exact same visibility as the
      // parent Moment, including follower-only posts.
      match /comments/{commentId} {
        allow read: if isSignedIn() && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow write: if false;
      }
    }

    match /couples/{coupleId} {
      // The creator must be able to retrieve a pending couple in order to display its invite
      // code. Writes and all date/social subcollections remain restricted to active couples.
      allow read: if isCoupleMember(coupleId);
      allow write: if false;

      match /dateRequests/{requestId} {
        allow read: if isActiveMember(coupleId);
        allow write: if false;
      }

      match /savedDates/{savedDateId} {
        allow read: if isActiveMember(coupleId);

        allow create: if isActiveMember(coupleId)
          && canCreateSavedDate();

        allow update: if isActiveMember(coupleId)
          && canUpdateSavedDate();

        // Dates are preserved as shared history and are cancelled rather than deleted.
        allow delete: if false;
      }

      // A server-maintained projection of followed posts. Members can read only their own
      // couple's feed; Cloud Functions are the sole writer.
      match /feedItems/{postId} {
        allow read: if isActiveMember(coupleId);
        allow write: if false;
      }
    }
  }
}
